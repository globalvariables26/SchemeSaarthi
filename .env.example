# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Groq — free account at https://console.groq.com, no card required
GROQ_API_KEY=

# Supabase — from your shared project's Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# data.gov.in — free account + API key at https://data.gov.in (My Account > API Keys)
DATA_GOV_IN_API_KEY=

# Backend
BACKEND_PORT=8000
CORS_ALLOWED_ORIGIN=http://localhost:3000
